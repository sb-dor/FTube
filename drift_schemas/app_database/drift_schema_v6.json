      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"video_history\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"videoId\" TEXT NULL, \"videoThumbnailUrl\" TEXT NULL, \"views\" TEXT NULL, \"duration\" TEXT NULL, \"title\" TEXT NULL, \"channelName\" TEXT NULL, \"channelThumb\" TEXT NULL, \"videoDate\" TEXT NULL, \"date_time\" TEXT NULL);"
        }
      ]
    },
