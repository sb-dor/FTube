        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"playlists\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "playlist_videos",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"playlist_videos\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"videoId\" TEXT NULL, \"videoThumbnailUrl\" TEXT NULL, \"views\" TEXT NULL, \"duration\" TEXT NULL, \"title\" TEXT NULL, \"channelName\" TEXT NULL, \"channelThumb\" TEXT NULL, \"videoDate\" TEXT NULL, \"date_time\" TEXT NULL, \"play_list_id\" INTEGER NULL REFERENCES playlists (id) ON UPDATE NO ACTION ON DELETE NO ACTION);"
        }
      ]
    },
